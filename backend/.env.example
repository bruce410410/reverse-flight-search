# 伺服器設定
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS 允許的前端來源
CORS_ORIGIN=http://localhost:3000

# Redis 連線設定
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 連線逾時 (ms)
REDIS_CONNECT_TIMEOUT_MS=5000
# 最大重試次數（超過後停止自動重連，改由應用層處理）
REDIS_MAX_RETRIES=10

# Sky-scrapper（RapidAPI，反向搜票核心邏輯，目前使用中）
# 2026-09 第三次改版：Kiwi Tequila 已改邀請制、Travelpayouts 需要先讓其「Drive」
# 外掛在自己網站上通過驗證才能拿到 token、Duffel 的正式帳號註冊表單強制要求
# Company name 與 Country of incorporation 且國家清單沒有台灣（也沒有整個亞洲）
# ——細節見 TEST_REPORT_duffel-migration.md、TEST_REPORT_skyscrapper-migration.md
# 與 README「資料來源」。改用跟 AeroDataBox 同一個平台（RapidAPI）的 Sky-scrapper：
# 註冊只需要 email/password，沒有公司/國家限制，資料是 Skyscanner 的真實公開資料
# （不是像 Duffel 測試模式那樣的假資料），代價是免費方案每月只有 50 次呼叫額度
# （2026-09-22 用真實請求的 x-ratelimit-requests-limit header 驗證過，並非最初從
# 第三方部落格查到、估計錯誤的 100 次）、且是非官方社群維護的 API，沒有 SLA。
#
# 申請位置：https://rapidapi.com/ → 免費註冊（或用既有帳號，跟 AeroDataBox 共用）
# → 搜尋 "Sky Scrapper"（apiheya 提供）→ Subscribe to Test → 選 BASIC（$0）方案
# → 複製 X-RapidAPI-Key
SKYSCRAPPER_API_KEY=
SKYSCRAPPER_API_BASE_URL=https://sky-scrapper.p.rapidapi.com
SKYSCRAPPER_API_HOST=sky-scrapper.p.rapidapi.com
SKYSCRAPPER_REQUEST_TIMEOUT_MS=15000
# 候選出發地機場（逗號分隔的 IATA 機場代碼）。留空使用內建的預設清單（僅 6 個機場，
# 免費額度每月實際 50 次的考量，見 backend/src/skyscrapper/candidateOrigins.ts 頂部註解）。
SKYSCRAPPER_CANDIDATE_ORIGINS=
# 機場代碼解析成 skyId/entityId 的快取存活時間（秒），預設 30 天，避免重複解析浪費額度。
SKYSCRAPPER_ENTITY_CACHE_TTL_SECONDS=2592000
SKYSCRAPPER_MARKET=en-US
SKYSCRAPPER_COUNTRY_CODE=US

# Duffel API：保留但目前未啟用（見上方 Sky-scrapper 說明）。若之後公司剛好在
# Duffel 支援的國家清單內，可換回這個資料源，模組沒有被刪除。
DUFFEL_API_TOKEN=
DUFFEL_API_BASE_URL=https://api.duffel.com
DUFFEL_REQUEST_TIMEOUT_MS=15000
DUFFEL_CANDIDATE_ORIGINS=

# Travelpayouts（Aviasales）Data API：保留但目前未啟用（見上方說明）。
TRAVELPAYOUTS_API_TOKEN=
TRAVELPAYOUTS_API_BASE_URL=https://api.travelpayouts.com
TRAVELPAYOUTS_REQUEST_TIMEOUT_MS=10000
TRAVELPAYOUTS_CANDIDATE_ORIGINS=

# AeroDataBox（即時航班狀態校驗，透過 RapidAPI）
# 申請位置：https://rapidapi.com/aedbx-aedbx/api/aerodatabox
AERODATABOX_API_KEY=
AERODATABOX_API_BASE_URL=https://aerodatabox.p.rapidapi.com
AERODATABOX_API_HOST=aerodatabox.p.rapidapi.com
AERODATABOX_REQUEST_TIMEOUT_MS=8000
# 未設定 AERODATABOX_API_KEY 時，系統會自動略過即時校驗（不會讓搜尋失敗）
AERODATABOX_VALIDATE_TOP_N=5

# SerpApi（Google Flights，反向搜票資料來源，目前使用中）
# 申請：https://serpapi.com → 註冊 → Dashboard 複製 API key（免費方案每月 250 次成功搜尋）
SERPAPI_API_KEY=
# 候選出發地（逗號分隔 IATA），留空用預設 14 個機場；每 7 個機場一次請求
SERPAPI_CANDIDATE_ORIGINS=
SERPAPI_MAX_ORIGINS_PER_REQUEST=7
SERPAPI_HL=en
SERPAPI_GL=tw
